rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Boards resource
    match /boards/{boardId} {
      allow get, create, update: if isValidId(boardId);
      allow list, delete: if false;

      // Tasks sub-resource
      match /tasks/{taskId} {
        allow get, create, update, delete: if isValidId(boardId) && isValidId(taskId);
        allow list: if isValidId(boardId);
      }
    }

    // Individual authenticated user custom account spaces
    match /users/{userId} {
      allow get, create, update: if request.auth != null && request.auth.uid == userId && isValidId(userId);
      allow list, delete: if false;

      match /tasks/{taskId} {
        allow get, create, update, delete: if request.auth != null && request.auth.uid == userId && isValidId(taskId);
        allow list: if request.auth != null && request.auth.uid == userId;
      }

      match /inbox/{inboxId} {
        allow get, create, update, delete: if request.auth != null && request.auth.uid == userId && isValidId(inboxId);
        allow list: if request.auth != null && request.auth.uid == userId;
      }

      match /habits/{habitId} {
        allow get, create, update, delete: if request.auth != null && request.auth.uid == userId && isValidId(habitId);
        allow list: if request.auth != null && request.auth.uid == userId;
      }

      match /stacks/{stackId} {
        allow get, create, update, delete: if request.auth != null && request.auth.uid == userId && isValidId(stackId);
        allow list: if request.auth != null && request.auth.uid == userId;
      }

      match /intentions/{intentId} {
        allow get, create, update, delete: if request.auth != null && request.auth.uid == userId && isValidId(intentId);
        allow list: if request.auth != null && request.auth.uid == userId;
      }

      match /logs/{dateKey} {
        allow get, create, update, delete: if request.auth != null && request.auth.uid == userId && isValidId(dateKey);
        allow list: if request.auth != null && request.auth.uid == userId;
      }

      // Shared daily routines used by Apps A, B, and C.
      match /routines/{routineId} {
        allow get, create, update, delete: if request.auth != null && request.auth.uid == userId && isValidId(routineId);
        allow list: if request.auth != null && request.auth.uid == userId;
      }

      // One idempotent record per routine and local calendar date.
      match /routineCompletions/{completionId} {
        allow get, create, update, delete: if request.auth != null && request.auth.uid == userId && isValidId(completionId);
        allow list: if request.auth != null && request.auth.uid == userId;
      }

      match /visionStrategies/{strategyId} {
        allow get, create, update, delete: if request.auth != null && request.auth.uid == userId && isValidId(strategyId);
        allow list: if request.auth != null && request.auth.uid == userId;
      }

      match /todayCandidates/{candidateId} {
        allow get, create, update, delete: if request.auth != null && request.auth.uid == userId && isValidId(candidateId);
        allow list: if request.auth != null && request.auth.uid == userId;
      }
    }

    // App A data is isolated from legacy task documents and is private to its owner.
    match /appAUsers/{userId} {
      allow get, create, update: if request.auth != null && request.auth.uid == userId && isValidId(userId);
      allow list, delete: if false;

      match /dailyResets/{dateKey} {
        allow get, create, update, delete: if request.auth != null && request.auth.uid == userId && isValidId(dateKey);
        allow list: if request.auth != null && request.auth.uid == userId;
      }

      // Explicit owner-scoped rollover decisions for unfinished previous daily-plan items.
      match /rolloverDecisions/{decisionId} {
        allow get, create, update, delete: if request.auth != null && request.auth.uid == userId && isValidId(decisionId);
        allow list: if request.auth != null && request.auth.uid == userId;
      }

      match /inboxItems/{inboxItemId} {
        allow get, create, update, delete: if request.auth != null && request.auth.uid == userId && isValidId(inboxItemId);
        allow list: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
